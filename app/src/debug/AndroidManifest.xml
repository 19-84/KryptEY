<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A text field for the keyboard to attach to, in the DEBUG source set only.

      It cannot live in the androidTest APK, which is where it started: instrumentation runs inside
      the target package's process, and startActivitySync refuses an activity belonging to another
      one - "Intent in process com.amnesica.kryptey resolved to different process
      com.amnesica.kryptey.test". So it has to be part of the app under test. src/debug keeps it out
      of every release build, and ReleaseManifestHasNoTestScaffoldingTest checks that rather than
      trusting it.

      Why any of this is needed: InputMethodManagerService binds an input method lazily, when a
      client's editable view asks for input. Selecting a keyboard only writes a setting, and dumpsys
      will report a selected method that was never bound - the state that made exported="false" look
      settled when nothing had tested it.
    -->
    <application>
        <!--
          configChanges so a rotation does not recreate it.

          A device test rotates this activity to measure the keyboard in landscape, where it runs in
          the platform's fullscreen/extract mode. Without this, setRequestedOrientation destroys and
          recreates the activity, the test's reference goes stale, and the run fails on "the host
          field never gained window focus" - a harness failure the test correctly names as one
          rather than reporting it as a finding about autofill.

          Debug-only scaffolding, so this changes nothing that ships.
        -->
        <activity
            android:name="com.amnesica.kryptey.inputmethod.EditableFieldActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="KryptEY test field" />

        <!--
          An autofill service that fills nothing and records what it is shown. Debug-only: an app
          that ships its own autofill service is a different app. Guarded by
          ReleaseManifestHasNoTestScaffoldingTest, which derives its list from src/debug/java.
        -->
        <!--
          Labelled explicitly. The debug APK carries the same applicationId as release, so without
          this the service inherits the application label and a tester's autofill picker offers
          "KryptEY" as a password manager. Selecting it would silently disable their real one and
          route every app's form structures through this process, which fills nothing.
        -->
        <service
            android:name="com.amnesica.kryptey.inputmethod.RecordingAutofillService"
            android:label="KryptEY test recorder - DO NOT ENABLE"
            android:exported="false"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/recording_autofill_service" />
        </service>
    </application>
</manifest>
