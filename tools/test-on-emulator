#!/bin/bash
# Runs the instrumentation tests on a real Android runtime.
#
# These are the tests Robolectric cannot run: AndroidKeystoreCryptoBoxTest exercises the
# Android Keystore, and a keystore needs a platform provider behind it rather than a shim.
# Before this script existed they had never been executed - they compiled, and that was all
# anyone knew about them.
#
# There is no /dev/kvm here, so the guest runs under software emulation. Budget ~10 minutes
# for the boot; the tests themselves take about 9 seconds once it is up.
set -e

IMAGE="${KRYPTEY_EMU_IMAGE:-kryptey-emu:30}"
NAME="${KRYPTEY_EMU_CONTAINER:-kryptey-emu-run}"
BOOT_TIMEOUT="${KRYPTEY_EMU_BOOT_TIMEOUT:-1800}"
ADB=/opt/android-sdk/platform-tools/adb
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! docker image inspect "$IMAGE" > /dev/null 2>&1; then
  echo "==> building $IMAGE (this pulls a system image; several minutes)"
  docker build -t "$IMAGE" tools/emulator
fi

cleanup() {
  # Point the device back at no autofill provider before letting go of it. The container is torn
  # down immediately after, so this is belt-and-braces here - but this script is the documented way
  # to run these tests, and against a persistent device (KRYPTEY_EMU_CONTAINER pointing at one you
  # keep) it would otherwise leave a recorder installed as the active provider.
  docker exec "$NAME" $ADB shell settings put secure autofill_service null > /dev/null 2>&1 || true
  docker rm -f "$NAME" > /dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

# Deliberately NOT passing -cores. Multi-core TCG was tried and the guest's system server took a
# native crash inside four minutes, taking every app down with it (DeadSystemException across the
# board). More host CPU does not help a workload that is single-threaded per guest core anyway.
echo "==> starting the emulator"
docker run -d --name "$NAME" "$IMAGE" bash -lc '
  export ANDROID_AVD_HOME=$HOME/.android/avd
  nohup /opt/android-sdk/emulator/emulator -avd test28 -no-window -no-audio -no-snapshot \
     -no-accel -gpu swiftshader_indirect -no-boot-anim -memory 3072 \
     > /tmp/emu.log 2>&1 &
  sleep infinity' > /dev/null

echo "==> waiting for boot (up to ${BOOT_TIMEOUT}s)"
deadline=$((SECONDS + BOOT_TIMEOUT))
until [ "$(docker exec "$NAME" $ADB shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
  if [ $SECONDS -ge $deadline ]; then
    echo "!! the emulator did not boot. Its log:"
    docker exec "$NAME" tail -30 /tmp/emu.log || true
    exit 1
  fi
  # A dead emulator and a slow one look identical from outside, and one of them is worth
  # saying out loud rather than waiting another twenty minutes for.
  if ! docker exec "$NAME" pgrep -f qemu-system > /dev/null 2>&1; then
    echo "!! the emulator process is gone. Its log:"
    docker exec "$NAME" tail -30 /tmp/emu.log || true
    exit 1
  fi
  sleep 15
done
echo "==> booted: $(docker exec "$NAME" $ADB shell getprop ro.build.version.sdk | tr -d '\r') / $(docker exec "$NAME" $ADB shell getprop ro.product.cpu.abi | tr -d '\r')"

# sys.boot_completed fires before the system services finish registering, and under software
# emulation that gap is wide - wide enough that an install lands in it and adb reports
# "Can't find service: input_method" with no hint that the device simply was not ready.
echo "==> waiting for the input-method service"
deadline=$((SECONDS + 600))
until docker exec "$NAME" $ADB shell service check input_method 2>/dev/null | grep -q ": found"; do
  if [ $SECONDS -ge $deadline ]; then
    echo "!! the input-method service never registered; the system server may have restarted"
    docker exec "$NAME" tail -30 /tmp/emu.log || true
    exit 1
  fi
  # Same check the boot loop makes, for the same reason: 2>/dev/null on the line above discards
  # docker's own errors and the pipeline's status is grep's, so a container that has died is
  # indistinguishable from a service that is merely slow - and this loop would spend its whole
  # 600s before printing a confident, wrong diagnosis.
  if ! docker exec "$NAME" pgrep -f qemu-system > /dev/null 2>&1; then
    echo "!! the emulator process is gone while waiting for the input-method service. Its log:"
    docker exec "$NAME" tail -30 /tmp/emu.log || true
    exit 1
  fi
  sleep 10
done

# An ANR dialog takes window focus away from whatever is in front, and a test whose field never
# gets focus never establishes an input connection - so the keyboard is never bound and the
# failure reads as a broken keyboard rather than a starved emulator.
docker exec "$NAME" $ADB shell settings put global hide_error_dialogs 1 > /dev/null 2>&1 || true
if [ "$(docker exec "$NAME" $ADB shell settings get global hide_error_dialogs | tr -d '\r')" != "1" ]; then
  echo "!! could not suppress ANR dialogs. An ANR takes window focus, and a test whose field never"
  echo "!! gets focus reports the keyboard as unbindable. Refusing to run a suite that would lie."
  exit 1
fi

# ...and then reboot, because writing the setting is not enough. ActivityManager decides whether to
# show error dialogs in updateShouldShowDialogsLocked, which re-reads this only on a configuration
# change - so a value written after boot does nothing for the boot that is already underway. That
# was measured the hard way: with the setting confirmed at 1, SystemUI still went not-responding
# and its dialog held window focus. The dialog cannot be dismissed once it exists - not by BACK,
# not by CLOSE_SYSTEM_DIALOGS, not by force-stopping SystemUI, not by forcing a density change.
# A reboot costs about ninety seconds and is the only reliable answer.
echo "==> rebooting so the ANR-dialog setting takes effect"
docker exec "$NAME" $ADB reboot > /dev/null 2>&1 || true
sleep 20
deadline=$((SECONDS + BOOT_TIMEOUT))
until [ "$(docker exec "$NAME" $ADB shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = "1" ]; do
  if [ $SECONDS -ge $deadline ]; then echo "!! the device did not come back from reboot"; exit 1; fi
  sleep 10
done
until docker exec "$NAME" $ADB shell service check input_method 2>/dev/null | grep -q ": found"; do
  if [ $SECONDS -ge $deadline ]; then echo "!! input-method service missing after reboot"; exit 1; fi
  sleep 10
done

# x86_64 is not a shipped ABI, so it has to be asked for explicitly - see the splits block.
#
# IgnoredTestsAreAccountedForTest runs in the same invocation, deliberately. It is the only thing
# that catches a device test disabled by an @Ignore or an assumption, and it lives in the JVM suite
# - which this script never ran. So "==> PASSED" from here meant "at least one device test passed",
# and an @Ignore on a whole device class would have left it saying exactly that while the class it
# silenced held a security property. The guard is the right one; it was running in the wrong
# command.
#
# Not a hard-coded expected count. That figure already exists in four places this repo has had to
# unpick twice, and a legitimately added test would then fail the harness for the wrong reason.
echo "==> building the x86_64 APKs, and checking no device test is quietly disabled"
tools/build-in-docker assembleDebug assembleDebugAndroidTest -PemulatorAbi
tools/build-in-docker testDebugUnitTest --tests '*IgnoredTestsAreAccountedFor*' 

echo "==> installing"
docker cp app/build/outputs/apk/debug/app-x86_64-debug.apk "$NAME":/tmp/app.apk
docker cp app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk "$NAME":/tmp/test.apk
docker exec "$NAME" $ADB install -r -t /tmp/app.apk
docker exec "$NAME" $ADB install -r -t /tmp/test.apk

# Selecting an input method needs shell privileges the test process does not have. Without this
# the binding test cannot run at all - and it would fail looking like a broken keyboard rather
# than a harness step that was skipped, which is why the test asserts this as a precondition.
echo "==> selecting the keyboard as the input method"
docker exec "$NAME" $ADB shell ime enable com.amnesica.kryptey/.inputmethod.latin.LatinIME
docker exec "$NAME" $ADB shell ime set com.amnesica.kryptey/.inputmethod.latin.LatinIME

# The autofill experiment needs a service registered, and only shell can register one. Without it
# AutofillDoesNotReachTheKeyboardTest asserts its precondition and stops, rather than quietly
# "passing" by finding the compose box absent from zero structures.
echo "==> enabling the recording autofill service"
docker exec "$NAME" $ADB shell settings put secure autofill_service \
  'com.amnesica.kryptey/com.amnesica.kryptey.inputmethod.RecordingAutofillService'

# Two attempts, and the second one is loud about being a second one.
#
# The guest runs under software emulation with no /dev/kvm, and this harness has now produced two
# failures that did not reproduce: a native abort deep in the framework's view-tree draw with no
# application frame in the stack, and an instrumentation process that died before a single test
# started, leaving the crash buffer empty. Neither is a test result. The script's own header already
# records that multi-core TCG crashed the guest's system server, which is the same class of thing.
#
# A retry is a real risk - it can hide a test that fails intermittently for a reason of its own - so
# it is bounded at one, the first attempt's device state is still captured and printed, and a run
# that only passed the second time says so in its result line rather than reporting a clean pass.
# A reproducible failure fails both attempts and is reported exactly as before.
#
# KRYPTEY_TEST_CLASS narrows the run to one class or method, for probing. A full device run is about
# eight minutes and most questions here need two or three runs to settle - measure, mutate the
# production code, measure again - so paying eight minutes a time for an answer about one class is
# most of why device questions get deferred. Unset, everything runs, which is what CI and every
# report in this repo means by "the device suite".
#
#   KRYPTEY_TEST_CLASS=com.amnesica.kryptey.inputmethod.latin.e2ee.SomeTest ./tools/test-on-emulator
#   KRYPTEY_TEST_CLASS=com...SomeTest#oneMethod ./tools/test-on-emulator
run_instrumentation() {
  if [ -n "${KRYPTEY_TEST_CLASS:-}" ]; then
    echo "==> NARROWED to $KRYPTEY_TEST_CLASS - this is not the full device suite"
    docker exec "$NAME" $ADB shell am instrument -w -r \
      -e class "$KRYPTEY_TEST_CLASS" \
      com.amnesica.kryptey.test/androidx.test.runner.AndroidJUnitRunner
    return
  fi
  docker exec "$NAME" $ADB shell am instrument -w -r \
    com.amnesica.kryptey.test/androidx.test.runner.AndroidJUnitRunner
}

# am instrument exits 0 whether the tests passed or not, so the result has to be read out of
# the stream rather than taken from the exit status.
# "OK (0 tests)" is also an OK line. A filter that matches nothing, or a test APK that contributed
# no runnable tests, would otherwise be reported as a pass - which is the vacuous-green shape this
# repo has had to unpick more than once.
passed() {
  echo "$1" | grep -qE '^OK \([1-9][0-9]* tests?\)'
}

capture_device_state() {
  # The container is about to be removed by the EXIT trap, taking with it the only copy of what
  # the device was doing - and re-running costs a full cold boot.
  echo "==> capturing device state"
  docker exec "$NAME" $ADB logcat -d -b crash 2>/dev/null | tail -60 || true
  # The main buffer too: the failure that started this retry left the crash buffer empty, so the
  # only place anything about it could have been was here.
  docker exec "$NAME" $ADB logcat -d 2>/dev/null | tail -80 || true
  docker exec "$NAME" $ADB shell dumpsys window 2>/dev/null | grep -E 'mCurrentFocus|mFocusedApp' || true
  docker exec "$NAME" $ADB shell dumpsys input_method 2>/dev/null | grep -E 'mCurId|mCurMethodId|mBoundToMethod' || true
}

echo "==> running the instrumentation tests"
out=$(run_instrumentation)
echo "$out"

if passed "$out"; then
  echo "==> PASSED"
  exit 0
fi

capture_device_state
echo "==> the first attempt did not pass; retrying ONCE, because this harness has produced"
echo "==> failures that did not reproduce. A real failure will fail this attempt too."
out=$(run_instrumentation)
echo "$out"

if passed "$out"; then
  echo "==> PASSED ON THE SECOND ATTEMPT - the first attempt did NOT pass; its device state is"
  echo "==> printed above. Treat this as a flake to be explained, not as a clean run."
  exit 0
fi

echo "==> FAILED"
capture_device_state
exit 1
